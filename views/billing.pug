extends base

mixin navItem(link,name,icon,active)
  li(class =`${active ?'side-nav--active':''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`img/icons.svg#icon-${icon}`)
      | #{name}



block content 
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('#','Settings','settings',true)
          +navItem('/my-tours','My bookings','briefcase',false)
          +navItem('/my-reviews','My reviews','star',false)
          +navItem('/billing','Billing','credit-card',false)


      .user-view__content
        if bookings.length
          .review-card 
            each booking  in bookings
              .review-content 
                p.review__text-name= booking.user.name
                p.review__text-name= booking.tour.name
                p.review__text= `$${booking.price}`
                span= booking.createAt.toLocaleString('en-Us',{month:'long',year:'numeric'})

        else         
          .review-content 
            p.review__text You don't have any billing
